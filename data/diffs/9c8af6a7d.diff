+from datetime import date, timedelta
+
+def weekly_summary(workspace_id: int, week_start: date) -> dict:
+    """Aggregate logged time per project for one week."""
+    end = week_start + timedelta(days=7)
+    rows = db.entries.by_range(workspace_id, week_start, end)
+    per_project = {}
+    for r in rows:
+        per_project.setdefault(r.project_id, 0)
+        per_project[r.project_id] += r.duration_minutes
+    return {'week_start': week_start, 'projects': per_project}
