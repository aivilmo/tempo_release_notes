@@ -0,0 +1,9 @@
+import csv, io
+
+def to_csv(summary: dict) -> str:
+    buf = io.StringIO()
+    w = csv.writer(buf)
+    w.writerow(['project', 'hours'])
+    for pid, minutes in summary['projects'].items():
+        w.writerow([pid, round(minutes / 60, 2)])
+    return buf.getvalue()
