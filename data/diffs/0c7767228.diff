@@ -0,0 +1,11 @@
+class LinearSync:
+    def __init__(self, token: str):
+        self.client = LinearClient(token)
+
+    def pull_projects(self, workspace_id: int) -> int:
+        remote = self.client.projects()
+        n = 0
+        for p in remote:
+            projects.upsert(workspace_id, external_id=p.id, name=p.name)
+            n += 1
+        return n
