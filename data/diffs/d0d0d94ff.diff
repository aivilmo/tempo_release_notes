+def hours_per_client(workspace_id: int, month: date) -> dict:
+    rows = db.entries.by_month(workspace_id, month)
+    out = {}
+    for r in rows:
+        out.setdefault(r.project.client_id, 0)
+        out[r.project.client_id] += r.duration_minutes
+    return out
